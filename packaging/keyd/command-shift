# ⇧⌘, in every app.
# ⇧⌘3 the screen, ⇧⌘4 a part of it: straight to the Desktop, with a
# thumbnail in the corner (session/org.ambrosia.screenshot*.desktop hold
# these two chords). ⇧⌘5 the screenshot tool (Spectacle).
3 = C-M-A-3
4 = C-M-A-4
5 = sysrq
# ⇧⌘[ ⇧⌘] the tab before and after.
leftbrace = C-pageup
rightbrace = C-pagedown
# ⇧⌘Q log out, after asking (session/org.ambrosia.logout.desktop holds the
# chord): without this line it was the app's Ctrl+Shift+Q, which quits
# Firefox.
q = C-M-A-S-q
# ⇧⌘H and ⇧⌘M are the app's own (Notes' Heading and Monostyled, Finder's
# Go Home): without these lines they fell to ⌘H and ⌘M with Shift held,
# which hid nothing, minimized nothing and never reached the app.
h = C-S-h
m = C-S-m
