+///! A DBusMenu at a known address.
+/// The `com.canonical.dbusmenu` menu that @@service publishes at @@path, such
+/// as the application menu a window advertises. Pass it to
+/// @@Quickshell.QsMenuOpener or @@Quickshell.QsMenuAnchor to read or show it.
+class DBusMenuSource: public menu::QsMenuHandle {
+	Q_OBJECT;
+	/// The DBus service that owns the menu.
+	Q_PROPERTY(QString service READ service WRITE setService NOTIFY serviceChanged);
+	/// The object path of the menu.
+	Q_PROPERTY(QString path READ path WRITE setPath NOTIFY pathChanged);
+	QML_ELEMENT;
+
+public:
+	explicit DBusMenuSource(QObject* parent = nullptr);
+
+	void refHandle() override { this->handle.refHandle(); }
+	void unrefHandle() override { this->handle.unrefHandle(); }
+	[[nodiscard]] menu::QsMenuEntry* menu() override { return this->handle.menu(); }
+
+	[[nodiscard]] QString service() const { return this->mService; }
+	void setService(const QString& service);
+
+	[[nodiscard]] QString path() const { return this->mPath; }
+	void setPath(const QString& path);
+
+signals:
+	void serviceChanged();
+	void pathChanged();
+
+private:
+	DBusMenuHandle handle {this};
+	QString mService;
+	QString mPath;
+};
+
 } // namespace qs::dbus::dbusmenu
