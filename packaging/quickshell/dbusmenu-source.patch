+
+void DBusMenuSource::setService(const QString& service) {
+	if (service == this->mService) return;
+	this->mService = service;
+	this->handle.setAddress(this->mService, this->mPath);
+	emit this->serviceChanged();
+}
+
+void DBusMenuSource::setPath(const QString& path) {
