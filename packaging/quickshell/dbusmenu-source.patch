 QsMenuEntry* DBusMenuHandle::menu() { return this->loaded ? &this->mMenu->rootItem : nullptr; }
 
+DBusMenuSource::DBusMenuSource(QObject* parent): menu::QsMenuHandle(parent) {
+	QObject::connect(&this->handle, &menu::QsMenuHandle::menuChanged, this, &menu::QsMenuHandle::menuChanged);
+}
+
+void DBusMenuSource::setService(const QString& service) {
+	if (service == this->mService) return;
+	this->mService = service;
+	this->handle.setAddress(this->mService, this->mPath);
+	emit this->serviceChanged();
+}
+
+void DBusMenuSource::setPath(const QString& path) {
+	if (path == this->mPath) return;
+	this->mPath = path;
+	this->handle.setAddress(this->mService, this->mPath);
+	emit this->pathChanged();
+}
