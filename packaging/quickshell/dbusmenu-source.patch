+void DBusMenuItem::sendOpened() const {
+	this->menu->sendEvent(this->id, "opened");
+	// Apps learn a menu is about to show from AboutToShow, not from the "opened" event (Qt
+	// ignores it), so ask on every open, as libdbusmenu-qt does, and take any update it makes.
+	this->menu->prepareToShow(this->id, -1);
+}
