# Trusts the key Ambrosia's packages are signed with, as archlinux-keyring
# does Arch's. On a new install pacstrap -K has made the keyring by now; on
# the live image pacman-init.service populates it at boot.

populate_ambrosia() {
	if usr/bin/pacman-key -l >/dev/null 2>&1; then
		usr/bin/pacman-key --populate ambrosia
	fi
}

# PackageKit, unlike pacman, carries one section's SigLevel on to the next
# section that has none. [ambrosia]'s Required then asks a signature of Arch's
# unsigned databases, and PackageKit drops those repos without a word, so
# Software Update sees only ours. pacman's own default, said outright, stops it.
# The installer writes the same; this is for systems installed before that.
explicit_siglevels() {
	grep -qx '\[ambrosia\]' etc/pacman.conf 2>/dev/null || return 0
	sed -i '/^\[\(core\|extra\|multilib\)\]$/{n;/^SigLevel/!i\
SigLevel = Required DatabaseOptional
}' etc/pacman.conf
}

post_install() {
	if [ -x usr/bin/pacman-key ]; then
		populate_ambrosia
	fi
	explicit_siglevels
}

post_upgrade() {
	populate_ambrosia
	explicit_siglevels
}
