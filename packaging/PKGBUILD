# Builds Ambrosia's packages from this checkout: `make package` on Arch.
# ambrosia-keyring the key the packages are signed with, and the repo's address
# ambrosia-theme   the generated themes (Qt/QML, KDE, GTK, fontconfig)
# ambrosia-decoration the window frame with the traffic lights, a KWin plugin (decoration/)
# ambrosia-style   the Qt widget style: other apps' buttons, boxes and menus (style/)
# ambrosia-input   the session's input method: the emoji picker types through it (input/)
# ambrosia-glass   glass: a KWin effect in its blur's place, and the QML module that names panes to it (glass/)
# ambrosia-shell   the Quickshell shell and the Ambrosia session on KWin
# ambrosia-files   Files, Ambrosia's Finder (files/, built with CMake)
# ambrosia-settings System Settings (settings/, built with CMake)
# ambrosia-desktop everything a fresh install needs, the ISO installs this

pkgbase=ambrosia
pkgname=(ambrosia-keyring ambrosia-theme ambrosia-decoration ambrosia-style ambrosia-input ambrosia-glass ambrosia-shell ambrosia-files ambrosia-settings ambrosia-desktop)
pkgver=0.1.0
pkgrel=1
pkgdesc="A Linux desktop that looks and moves as one thing"
# x86_64 for ambrosia-files, ambrosia-settings, ambrosia-decoration, ambrosia-style, ambrosia-input and ambrosia-glass; the rest are arch=(any).
arch=(x86_64)
url="https://github.com/justin06lee/ambrosia"
license=(LicenseRef-TBD)
makedepends=(bun git librsvg cmake ninja qt6-base qt6-declarative qt6-svg kio kservice kwindowsystem taglib karchive freetype2
             kdecoration kcoreaddons pulseaudio-qt networkmanager-qt bluez-qt libkscreen wayland wayland-protocols
             kwin extra-cmake-modules vulkan-headers libepoxy libdrm)
options=(!debug)

_root="$(realpath "$startdir/..")"

pkgver() {
  cd "$_root"
  printf '0.1.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_root"
  bun install --frozen-lockfile
  bun tools/gen/index.ts
  for w in nectar-day nectar-night; do
    rsvg-convert -w 3840 -h 2400 "assets/wallpapers/$w.svg" -o "$srcdir/$w.png"
  done
  cmake -S files -B "$srcdir/build-files" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-files"
  cmake -S decoration -B "$srcdir/build-decoration" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-decoration"
  cmake -S settings -B "$srcdir/build-settings" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-settings"
  cmake -S style -B "$srcdir/build-style" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-style"
  cmake -S input -B "$srcdir/build-input" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-input"
  cmake -S glass -B "$srcdir/build-glass" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-glass"
}

package_ambrosia-keyring() {
  pkgdesc="The key Ambrosia's packages are signed with, and where pacman gets them"
  arch=(any)
  # After pacman, so pacman-key is there when the install script trusts the key.
  depends=(pacman)
  install=ambrosia-keyring.install
  backup=(etc/pacman.d/ambrosia-mirrorlist)
  cd "$_root/packaging/keyring"

  install -Dm644 ambrosia.gpg ambrosia-trusted ambrosia-revoked -t "$pkgdir/usr/share/pacman/keyrings/"
  install -Dm644 ambrosia-mirrorlist -t "$pkgdir/etc/pacman.d/"
}

package_ambrosia-theme() {
  pkgdesc="Ambrosia's design tokens as Qt/QML, KDE, GTK and fontconfig themes"
  arch=(any)
  # libpulse: paplay, which /usr/lib/ambrosia/sound plays with.
  depends=(inter-font ttf-jetbrains-mono libpulse)
  optdepends=('ocean-sound-theme: the sounds Ambrosia has none of its own for')
  cd "$_root/dist"

  install -Dm644 qml/Ambrosia/Theme.qml qml/Ambrosia/qmldir -t "$pkgdir/usr/lib/qt6/qml/Ambrosia/"
  install -Dm644 kde/AmbrosiaLight.colors kde/AmbrosiaDark.colors -t "$pkgdir/usr/share/color-schemes/"
  install -Dm644 gtk-4.0/gtk.css -t "$pkgdir/usr/share/ambrosia/gtk-4.0/"
  install -Dm644 gtk-3.0/gtk-light.css gtk-3.0/gtk-dark.css -t "$pkgdir/usr/share/ambrosia/gtk-3.0/"
  # The window controls' glyphs, beside the CSS that draws them.
  install -Dm644 gtk-4.0/assets/*.svg -t "$pkgdir/usr/share/ambrosia/gtk-4.0/assets/"
  install -Dm644 gtk-3.0/assets/*.svg -t "$pkgdir/usr/share/ambrosia/gtk-3.0/assets/"
  install -Dm644 environment.d/50-ambrosia-fonts.conf -t "$pkgdir/usr/share/ambrosia/environment.d/"
  install -Dm644 fontconfig/50-ambrosia.conf -t "$pkgdir/usr/share/fontconfig/conf.avail/"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.avail/50-ambrosia.conf "$pkgdir/etc/fonts/conf.d/50-ambrosia.conf"

  install -Dm644 "$srcdir/nectar-day.png" "$srcdir/nectar-night.png" -t "$pkgdir/usr/share/ambrosia/wallpapers/"
  install -Dm644 "$_root"/assets/wallpapers/*.svg -t "$pkgdir/usr/share/ambrosia/wallpapers/"
  # The icon theme: app icons under the names the installed apps ask for,
  # and the pointer (Xcursor files, KWin's SVGs). Every other name an icon
  # or a shape goes by is a link (cp -a keeps them links).
  install -d "$pkgdir/usr/share/icons"
  cp -a icons/Ambrosia "$pkgdir/usr/share/icons/Ambrosia"
  # The sound theme ("ambrosia": the alert, the Trash, a screenshot, the
  # volume), its other names as links, and what plays one by name for the
  # shell and Files.
  install -d "$pkgdir/usr/share/sounds"
  cp -a sounds/ambrosia "$pkgdir/usr/share/sounds/ambrosia"
  install -Dm755 "$_root/session/sound" -t "$pkgdir/usr/lib/ambrosia/"
  # The picture while the computer starts (a Plymouth theme; it shows once
  # ambrosia-desktop's boot-picture has switched it on).
  install -Dm644 plymouth/ambrosia/* -t "$pkgdir/usr/share/plymouth/themes/ambrosia/"
  # Files' and Settings' icons in hicolor too, for sessions on another theme.
  install -Dm644 "$_root"/assets/icons/*.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  # Files' folder and document, by name (ambrosia-folder, ambrosia-document)
  # for the shell's Search; the small page where Files draws its small one.
  local hicolor="$pkgdir/usr/share/icons/hicolor" art="$_root/files/art" size
  install -Dm644 "$art/folder.svg" "$hicolor/scalable/places/ambrosia-folder.svg"
  install -Dm644 "$art/document.svg" "$hicolor/scalable/mimetypes/ambrosia-document.svg"
  for size in 16x16 16x16@2 32x32 32x32@2; do
    install -Dm644 "$art/document-small.svg" "$hicolor/$size/mimetypes/ambrosia-document.svg"
  done
}

package_ambrosia-decoration() {
  pkgdesc="Ambrosia's window frame for KWin: the traffic lights and a centered title on every window, and the blur behind KWin's own glass"
  depends=(kwin kdecoration kcoreaddons kwindowsystem kservice qt6-base qt6-declarative)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-decoration"
}

package_ambrosia-style() {
  pkgdesc="Ambrosia's Qt widget style: every Qt app's buttons, boxes, sliders and menus as the desktop draws its own"
  # It stands on Breeze for everything it doesn't draw itself. The session's
  # look-and-feel names it (widgetStyle=ambrosia); anywhere else an app uses it
  # when told to (QT_STYLE_OVERRIDE=ambrosia).
  depends=(qt6-base breeze kwindowsystem)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-style"
}

package_ambrosia-input() {
  pkgdesc="Ambrosia's input method for KWin: the shell types into the app in front through it (the emoji picker's choice)"
  # KWin starts it: the session's kwinrc names its desktop file ([Wayland]
  # InputMethod). It draws nothing and takes no keys.
  depends=(wayland kwin)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-input"
}

package_ambrosia-glass() {
  pkgdesc="Ambrosia's glass: a KWin effect that blurs and saturates behind each pane as its material asks, and the QML module that names panes to it"
  # The effect is forked from KWin's blur and linked to KWin; the QML
  # module is ours alone.
  license=(GPL-2.0-or-later MIT)
  # KWin loads an effect only into the version it was built for (a newer
  # KWin says so in the journal and leaves it out, and the session's own
  # blur stands in): this is rebuilt with every KWin release. No version is
  # named here, so that a KWin update is never held back by it.
  depends=(kwin kdecoration kcoreaddons qt6-base qt6-declarative wayland)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-glass"
  install -Dm644 "$_root/glass/effect/COPYING" "$pkgdir/usr/share/licenses/ambrosia-glass/GPL-2.0.txt"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/ambrosia-glass/MIT.txt"
}

package_ambrosia-shell() {
  pkgdesc="The Ambrosia shell (menu bar, dock, control center) and session on KWin"
  arch=(any)
  # quickshell-dbusmenu-source: only our Quickshell build (make quickshell)
  # provides it, so pacman won't swap Arch's in and lose the app menus.
  # kde-cli-tools: kstart and kioclient, which start apps in their own
  # scopes; dbus: dbus-test-tool holds the app menu view's bus name.
  # ambrosia-style: the widget style the look-and-feel names.
  # ambrosia-input and noto-fonts-emoji: the emoji picker types through the
  # one and draws with the other. ambrosia-glass: the shell's QML imports
  # its module, and the session's kwinrc switches its effect on.
  depends=(ambrosia-theme ambrosia-decoration ambrosia-style ambrosia-input ambrosia-glass quickshell-dbusmenu-source kwin plasma-workspace kde-cli-tools kconfig dbus
           qt6-svg qt6-imageformats upower dconf noto-fonts-emoji)
  backup=(etc/xdg/ambrosia/kdeglobals etc/xdg/ambrosia/kwinrc etc/xdg/ambrosia/kwinrulesrc
          etc/xdg/ambrosia/breezerc etc/xdg/ambrosia/mimeapps.list etc/xdg/ambrosia/kcminputrc
          etc/xdg/ambrosia/konsolerc)
  cd "$_root"

  install -d "$pkgdir/usr/share/ambrosia/shell" "$pkgdir/usr/share/plasma/look-and-feel"
  cp -r shell/. "$pkgdir/usr/share/ambrosia/shell/"

  install -Dm755 session/startambrosia session/ambrosia -t "$pkgdir/usr/bin/"
  # Light or dark for GTK 3 apps, run by the shell.
  install -Dm755 session/gtk-appearance -t "$pkgdir/usr/lib/ambrosia/"
  # The shell's grant to KWin's window list, Super+Space for Search and
  # Super+Ctrl+F for full screen.
  install -Dm644 session/org.ambrosia.shell.desktop session/org.ambrosia.search.desktop \
    session/org.ambrosia.fullscreen.desktop session/org.ambrosia.screenshot.desktop \
    session/org.ambrosia.screenshot-region.desktop session/org.ambrosia.force-quit.desktop \
    session/org.ambrosia.quit.desktop session/org.ambrosia.emoji.desktop \
    session/org.ambrosia.logout.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 session/ambrosia.desktop -t "$pkgdir/usr/share/wayland-sessions/"
  local units="$pkgdir/usr/lib/systemd/user"
  install -Dm644 session/ambrosia-shell.service -t "$units/"
  install -d "$units/plasma-core.target.wants"
  ln -s ../ambrosia-shell.service "$units/plasma-core.target.wants/ambrosia-shell.service"
  install -Dm644 session/plasmashell.conf "$units/plasma-plasmashell.service.d/ambrosia.conf"
  # The shell asks for passwords itself (polkit; shell/Authorization.qml).
  install -Dm644 session/plasma-polkit-agent.conf "$units/plasma-polkit-agent.service.d/ambrosia.conf"
  install -Dm644 session/ksplash.conf "$units/plasma-ksplash.service.d/ambrosia.conf"
  # Running shells restart after an upgrade; they don't reload themselves.
  install -Dm644 session/ambrosia-shell-restart.hook -t "$pkgdir/usr/share/libalpm/hooks/"
  install -Dm755 session/ambrosia-shell-restart -t "$pkgdir/usr/share/libalpm/scripts/"

  # Plasma writes its look-and-feel's defaults into ~/.config/kdedefaults,
  # ahead of /etc/xdg/ambrosia, so the session's colors live in one of ours.
  # -L: the window switcher borrows the shell's Glass and Label by symlink.
  cp -rL session/look-and-feel/. "$pkgdir/usr/share/plasma/look-and-feel/"
  # KWin effects of ours, off unless the session's kwinrc asks for them.
  # The lock screen: a Plasma shell package KDE's locker takes its QML from
  # (the session's plasmashellrc names it). -L: it is the login screen's own
  # file, by a link.
  install -d "$pkgdir/usr/share/plasma/shells"
  cp -rL session/plasma-shell/. "$pkgdir/usr/share/plasma/shells/"
  install -d "$pkgdir/usr/share/kwin/effects"
  # -L: Mission Control shares the shell's Label.qml by a link.
  cp -rL session/kwin-effects/. "$pkgdir/usr/share/kwin/effects/"
  install -d "$pkgdir/usr/share/kwin/scripts"
  cp -r session/kwin-scripts/. "$pkgdir/usr/share/kwin/scripts/"
  # The preview of where a dragged window will tile (kwinrc's [Outline]).
  install -Dm644 session/kwin-outline/outline.qml -t "$pkgdir/usr/share/kwin/outline/ambrosia/"
  install -Dm644 dist/kde/kdeglobals session/xdg/kwinrc session/xdg/kwinrulesrc session/xdg/breezerc session/xdg/mimeapps.list \
    session/xdg/kcminputrc session/xdg/konsolerc session/xdg/klaunchrc session/xdg/plasmashellrc \
    session/xdg/plasmaparc -t "$pkgdir/etc/xdg/ambrosia/"
  # Open and Save in every app are Files' panels (the desktop portal).
  install -Dm644 session/xdg/xdg-desktop-portal/portals.conf -t "$pkgdir/etc/xdg/ambrosia/xdg-desktop-portal/"
  # Konsole's profile and key table for the session (konsolerc names the
  # profile): Command chords Konsole has no use for don't reach the shell.
  install -Dm644 session/konsole/Ambrosia.profile session/konsole/ambrosia.keytab -t "$pkgdir/usr/share/konsole/"
  # The session's GSettings defaults (DCONF_PROFILE=ambrosia); dconf's own
  # pacman hook compiles the database.
  install -Dm644 session/dconf/profile "$pkgdir/etc/dconf/profile/ambrosia"
  install -Dm644 session/dconf/ambrosia.d/00-window-controls session/dconf/ambrosia.d/01-icons \
    session/dconf/ambrosia.d/02-sounds -t "$pkgdir/etc/dconf/db/ambrosia.d/"
}

package_ambrosia-files() {
  pkgdesc="Files, Ambrosia's Finder"
  # kio-extras: recentlyused:/ for Recents. ambrosia-theme: the Ambrosia QML
  # Theme module and the org.ambrosia.files icon. The QML and art are in the binary.
  # Files makes every thumbnail itself (ffmpeg, taglib, karchive, freetype2)
  # and searches contents itself: no KIO thumbnailers, no ripgrep. solid
  # (KIO's own dependency, with udisks2) lists the sidebar's other disks.
  # ambrosia-glass: the sidebar's QML imports org.ambrosia.glass.
  depends=(ambrosia-theme ambrosia-glass qt6-base qt6-declarative qt6-svg kio kio-extras kservice solid kwindowsystem inter-font ffmpeg taglib karchive freetype2)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-files"
}

package_ambrosia-settings() {
  pkgdesc="System Settings, Ambrosia's"
  # ambrosia-theme: the Ambrosia QML Theme module and the org.ambrosia.settings
  # icon. kcmutils: kcmshell6, which opens KDE's module for a pane not built
  # yet. hwdata: pci.ids, for About's graphics. networkmanager-qt: Wi-Fi.
  # bluez-qt: Bluetooth; bluedevil's agent asks for pairing codes.
  # libkscreen: Displays; powerdevil's brightness service dims them.
  # The QML and art are in the binary.
  depends=(ambrosia-theme ambrosia-glass qt6-base qt6-declarative qt6-svg kwindowsystem kconfig kservice kcmutils hwdata inter-font
           pulseaudio-qt libpulse plasma-pa networkmanager-qt networkmanager bluez-qt bluez bluedevil libkscreen powerdevil)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-settings"
}

package_ambrosia-desktop() {
  pkgdesc="The Ambrosia desktop: the shell plus the system services and apps a new install needs"
  arch=(any)
  depends=(
    ambrosia-shell ambrosia-keyring ambrosia-files ambrosia-settings ambrosia-style ambrosia-input
    # Low Power Mode (Battery), and printing (Printers & Scanners): ipp-usb
    # for the printers that plug in, started when one does.
    power-profiles-daemon cups avahi nss-mdns ipp-usb
    sddm xdg-desktop-portal-kde polkit-kde-agent kscreen powerdevil
    networkmanager plasma-nm bluez bluez-utils bluedevil
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber plasma-pa
    plasma-desktop breeze konsole dolphin systemsettings spectacle kinfocenter
    # The Mac-first keyboard: Super is Command (packaging/keyd).
    keyd
    # GTK 3 apps' menus in the menu bar (gtk-modules in settings.ini). Only
    # X11 windows can name their menu: KWin has no gtk_shell1, so Wayland
    # GTK windows keep theirs; GTK 4 has no modules.
    appmenu-gtk-module
    # The apps a new install starts with, and Discover to get more.
    firefox kate gwenview okular ark kcalc discover packagekit-qt6 flatpak
  )
  # Not a dependency: an installed system gets it by asking
  # (/usr/lib/ambrosia/boot-picture), a new one from the installer.
  optdepends=('plymouth: the mark and a bar while the computer starts, in place of text')
  backup=(etc/sddm.conf.d/10-ambrosia.conf etc/keyd/ambrosia.conf)
  cd "$_root"

  # In /etc: sddm's own /usr/lib/sddm/sddm.conf.d/default.conf would sort after
  # ours there and reset it. System Settings' kde_settings.conf still wins.
  install -Dm644 packaging/sddm.conf "$pkgdir/etc/sddm.conf.d/10-ambrosia.conf"
  # The login screen (it draws with ambrosia-theme's QML tokens and wallpapers).
  install -Dm644 packaging/sddm-theme/Main.qml packaging/sddm-theme/metadata.desktop packaging/sddm-theme/theme.conf \
    -t "$pkgdir/usr/share/sddm/themes/ambrosia/"
  # Updating the system asks for a password, as on a Mac (Arch lets wheel skip it).
  install -Dm644 packaging/polkit/10-ambrosia-packagekit.rules -t "$pkgdir/usr/share/polkit-1/rules.d/"

  # The Mac-first keyboard (docs/keyboard.md): keyd's config, with what every
  # Command layer shares beside keyd's own layouts; the bindings for each
  # kind of app, and the service that applies them when the shell names one.
  # It starts with keyd (keyd.service.wants), which the installer enables.
  install -Dm644 packaging/keyd/ambrosia.conf -t "$pkgdir/etc/keyd/"
  install -Dm644 packaging/keyd/command packaging/keyd/command-shift packaging/keyd/command-control \
    packaging/keyd/command-option -t "$pkgdir/usr/share/keyd/ambrosia/"
  install -Dm644 packaging/keyd/profiles/* -t "$pkgdir/usr/share/ambrosia/keys/"
  install -Dm755 packaging/keyd/ambrosia-keys "$pkgdir/usr/lib/ambrosia/keys"
  install -Dm644 packaging/keyd/ambrosia-keys.socket packaging/keyd/ambrosia-keys.service \
    -t "$pkgdir/usr/lib/systemd/system/"
  install -d "$pkgdir/usr/lib/systemd/system/keyd.service.wants"
  ln -s ../ambrosia-keys.socket "$pkgdir/usr/lib/systemd/system/keyd.service.wants/ambrosia-keys.socket"
  # A laptop's trackpad still rests while typing through keyd's keyboard.
  install -Dm644 packaging/keyd/keyd.quirks "$pkgdir/usr/share/libinput/50-ambrosia-keyd.quirks"

  # The picture while starting up: what switches it on (the installer runs
  # it), and Plymouth leaving its last frame up for the login screen.
  install -Dm755 packaging/plymouth/boot-picture -t "$pkgdir/usr/lib/ambrosia/"
  install -Dm644 packaging/plymouth/plymouth-quit.conf "$pkgdir/usr/lib/systemd/system/plymouth-quit.service.d/ambrosia.conf"

  # The system's name: our os-release, which a pacman hook keeps in /etc over
  # Arch's (About This Computer and the console read it), and its logo.
  install -Dm644 packaging/os-release/os-release -t "$pkgdir/usr/share/ambrosia/"
  install -Dm644 packaging/os-release/*.hook -t "$pkgdir/usr/share/libalpm/hooks/"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ambrosia-logo.svg"

  # Firefox takes the system titlebar, so it gets the traffic lights.
  install -Dm644 packaging/firefox/ambrosia.js -t "$pkgdir/usr/lib/firefox/browser/defaults/preferences/"

  # New accounts start with Ambrosia's GTK colors; the CSS follows the package.
  install -d "$pkgdir/etc/skel/.config/gtk-4.0" "$pkgdir/etc/skel/.config/gtk-3.0"
  printf '@import url("file:///usr/share/ambrosia/gtk-4.0/gtk.css");\n' > "$pkgdir/etc/skel/.config/gtk-4.0/gtk.css"
  printf '@import url("file:///usr/share/ambrosia/gtk-3.0/gtk-light.css");\n' > "$pkgdir/etc/skel/.config/gtk-3.0/gtk.css"
}
