# Builds Ambrosia's packages from this checkout: `make package` on Arch.
# ambrosia-keyring the key the packages are signed with, and the repo's address
# ambrosia-theme   the generated themes (Qt/QML, KDE, GTK, fontconfig)
# ambrosia-decoration the window frame with the traffic lights, a KWin plugin (decoration/)
# ambrosia-shell   the Quickshell shell and the Ambrosia session on KWin
# ambrosia-files   Files, Ambrosia's Finder (files/, built with CMake)
# ambrosia-settings System Settings (settings/, built with CMake)
# ambrosia-desktop everything a fresh install needs, the ISO installs this

pkgbase=ambrosia
pkgname=(ambrosia-keyring ambrosia-theme ambrosia-decoration ambrosia-shell ambrosia-files ambrosia-settings ambrosia-desktop)
pkgver=0.1.0
pkgrel=1
pkgdesc="A Linux desktop that looks and moves as one thing"
# x86_64 for ambrosia-files, ambrosia-settings and ambrosia-decoration; the rest are arch=(any).
arch=(x86_64)
url="https://github.com/justin06lee/ambrosia"
license=(LicenseRef-TBD)
makedepends=(bun git librsvg cmake ninja qt6-base qt6-declarative qt6-svg kio kwindowsystem taglib karchive freetype2
             kdecoration kcoreaddons pulseaudio-qt)
options=(!debug)

_root="$(realpath "$startdir/..")"

pkgver() {
  cd "$_root"
  printf '0.1.0.r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_root"
  bun install --frozen-lockfile
  bun tools/gen/index.ts
  for w in nectar-day nectar-night; do
    rsvg-convert -w 3840 -h 2400 "assets/wallpapers/$w.svg" -o "$srcdir/$w.png"
  done
  cmake -S files -B "$srcdir/build-files" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-files"
  cmake -S decoration -B "$srcdir/build-decoration" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-decoration"
  cmake -S settings -B "$srcdir/build-settings" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-settings"
}

package_ambrosia-keyring() {
  pkgdesc="The key Ambrosia's packages are signed with, and where pacman gets them"
  arch=(any)
  # After pacman, so pacman-key is there when the install script trusts the key.
  depends=(pacman)
  install=ambrosia-keyring.install
  backup=(etc/pacman.d/ambrosia-mirrorlist)
  cd "$_root/packaging/keyring"

  install -Dm644 ambrosia.gpg ambrosia-trusted ambrosia-revoked -t "$pkgdir/usr/share/pacman/keyrings/"
  install -Dm644 ambrosia-mirrorlist -t "$pkgdir/etc/pacman.d/"
}

package_ambrosia-theme() {
  pkgdesc="Ambrosia's design tokens as Qt/QML, KDE, GTK and fontconfig themes"
  arch=(any)
  depends=(inter-font ttf-jetbrains-mono)
  cd "$_root/dist"

  install -Dm644 qml/Ambrosia/Theme.qml qml/Ambrosia/qmldir -t "$pkgdir/usr/lib/qt6/qml/Ambrosia/"
  install -Dm644 kde/AmbrosiaLight.colors kde/AmbrosiaDark.colors -t "$pkgdir/usr/share/color-schemes/"
  install -Dm644 gtk-4.0/gtk.css -t "$pkgdir/usr/share/ambrosia/gtk-4.0/"
  install -Dm644 gtk-3.0/gtk-light.css gtk-3.0/gtk-dark.css -t "$pkgdir/usr/share/ambrosia/gtk-3.0/"
  # The window controls' glyphs, beside the CSS that draws them.
  install -Dm644 gtk-4.0/assets/*.svg -t "$pkgdir/usr/share/ambrosia/gtk-4.0/assets/"
  install -Dm644 gtk-3.0/assets/*.svg -t "$pkgdir/usr/share/ambrosia/gtk-3.0/assets/"
  install -Dm644 environment.d/50-ambrosia-fonts.conf -t "$pkgdir/usr/share/ambrosia/environment.d/"
  install -Dm644 fontconfig/50-ambrosia.conf -t "$pkgdir/usr/share/fontconfig/conf.avail/"
  install -d "$pkgdir/etc/fonts/conf.d"
  ln -s /usr/share/fontconfig/conf.avail/50-ambrosia.conf "$pkgdir/etc/fonts/conf.d/50-ambrosia.conf"

  install -Dm644 "$srcdir/nectar-day.png" "$srcdir/nectar-night.png" -t "$pkgdir/usr/share/ambrosia/wallpapers/"
  install -Dm644 "$_root"/assets/wallpapers/*.svg -t "$pkgdir/usr/share/ambrosia/wallpapers/"
  # App icons of our own (Files), for the Dock and the apps.
  install -Dm644 "$_root"/assets/icons/*.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
}

package_ambrosia-decoration() {
  pkgdesc="Ambrosia's window frame for KWin: the traffic lights and a centered title on every window"
  depends=(kwin kdecoration kcoreaddons qt6-base)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-decoration"
}

package_ambrosia-shell() {
  pkgdesc="The Ambrosia shell (menu bar, dock, control center) and session on KWin"
  arch=(any)
  # quickshell-dbusmenu-source: only our Quickshell build (make quickshell)
  # provides it, so pacman won't swap Arch's in and lose the app menus.
  # kde-cli-tools: kstart and kioclient, which start apps in their own
  # scopes; dbus: dbus-test-tool holds the app menu view's bus name.
  depends=(ambrosia-theme ambrosia-decoration quickshell-dbusmenu-source kwin plasma-workspace kde-cli-tools kconfig dbus
           qt6-svg qt6-imageformats upower dconf)
  backup=(etc/xdg/ambrosia/kdeglobals etc/xdg/ambrosia/kwinrc etc/xdg/ambrosia/breezerc
          etc/xdg/ambrosia/mimeapps.list)
  cd "$_root"

  install -d "$pkgdir/usr/share/ambrosia/shell" "$pkgdir/usr/share/plasma/look-and-feel"
  cp -r shell/. "$pkgdir/usr/share/ambrosia/shell/"

  install -Dm755 session/startambrosia session/ambrosia -t "$pkgdir/usr/bin/"
  # The shell's grant to KWin's window list, and Super+Space for Search.
  install -Dm644 session/org.ambrosia.shell.desktop session/org.ambrosia.search.desktop \
    -t "$pkgdir/usr/share/applications/"
  install -Dm644 session/ambrosia.desktop -t "$pkgdir/usr/share/wayland-sessions/"
  local units="$pkgdir/usr/lib/systemd/user"
  install -Dm644 session/ambrosia-shell.service -t "$units/"
  install -d "$units/plasma-core.target.wants"
  ln -s ../ambrosia-shell.service "$units/plasma-core.target.wants/ambrosia-shell.service"
  install -Dm644 session/plasmashell.conf "$units/plasma-plasmashell.service.d/ambrosia.conf"
  install -Dm644 session/ksplash.conf "$units/plasma-ksplash.service.d/ambrosia.conf"
  # Running shells restart after an upgrade; they don't reload themselves.
  install -Dm644 session/ambrosia-shell-restart.hook -t "$pkgdir/usr/share/libalpm/hooks/"
  install -Dm755 session/ambrosia-shell-restart -t "$pkgdir/usr/share/libalpm/scripts/"

  # Plasma writes its look-and-feel's defaults into ~/.config/kdedefaults,
  # ahead of /etc/xdg/ambrosia, so the session's colors live in one of ours.
  cp -r session/look-and-feel/. "$pkgdir/usr/share/plasma/look-and-feel/"
  install -Dm644 dist/kde/kdeglobals session/xdg/kwinrc session/xdg/breezerc session/xdg/mimeapps.list \
    -t "$pkgdir/etc/xdg/ambrosia/"
  # The session's GSettings defaults (DCONF_PROFILE=ambrosia); dconf's own
  # pacman hook compiles the database.
  install -Dm644 session/dconf/profile "$pkgdir/etc/dconf/profile/ambrosia"
  install -Dm644 session/dconf/ambrosia.d/00-window-controls -t "$pkgdir/etc/dconf/db/ambrosia.d/"
}

package_ambrosia-files() {
  pkgdesc="Files, Ambrosia's Finder"
  # kio-extras: recentlyused:/ for Recents. ambrosia-theme: the Ambrosia QML
  # Theme module and the org.ambrosia.files icon. The QML and art are in the binary.
  depends=(ambrosia-theme qt6-base qt6-declarative qt6-svg kio kio-extras kservice kwindowsystem inter-font ripgrep ffmpeg taglib karchive freetype2)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-files"
}

package_ambrosia-settings() {
  pkgdesc="System Settings, Ambrosia's"
  # ambrosia-theme: the Ambrosia QML Theme module and the org.ambrosia.settings
  # icon. kcmutils: kcmshell6, which opens KDE's module for a pane not built
  # yet. hwdata: pci.ids, for About's graphics. The QML and art are in the binary.
  depends=(ambrosia-theme qt6-base qt6-declarative qt6-svg kwindowsystem kconfig kcmutils hwdata inter-font
           pulseaudio-qt libpulse plasma-pa)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-settings"
}

package_ambrosia-desktop() {
  pkgdesc="The Ambrosia desktop: the shell plus the system services and apps a new install needs"
  arch=(any)
  depends=(
    ambrosia-shell ambrosia-keyring ambrosia-files ambrosia-settings
    # Low Power Mode (Battery), and printing (Printers & Scanners).
    power-profiles-daemon cups avahi nss-mdns
    sddm xdg-desktop-portal-kde polkit-kde-agent kscreen powerdevil
    networkmanager plasma-nm bluez bluez-utils bluedevil
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber plasma-pa
    plasma-desktop breeze konsole dolphin systemsettings spectacle kinfocenter
    # The apps a new install starts with, and Discover to get more.
    firefox kate gwenview okular ark kcalc discover packagekit-qt6 flatpak
  )
  backup=(etc/sddm.conf.d/10-ambrosia.conf)
  cd "$_root"

  # In /etc: sddm's own /usr/lib/sddm/sddm.conf.d/default.conf would sort after
  # ours there and reset it. System Settings' kde_settings.conf still wins.
  install -Dm644 packaging/sddm.conf "$pkgdir/etc/sddm.conf.d/10-ambrosia.conf"

  # The system's name: our os-release, which a pacman hook keeps in /etc over
  # Arch's (About This Computer and the console read it), and its logo.
  install -Dm644 packaging/os-release/os-release -t "$pkgdir/usr/share/ambrosia/"
  install -Dm644 packaging/os-release/*.hook -t "$pkgdir/usr/share/libalpm/hooks/"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ambrosia-logo.svg"

  # Firefox takes the system titlebar, so it gets the traffic lights.
  install -Dm644 packaging/firefox/ambrosia.js -t "$pkgdir/usr/lib/firefox/browser/defaults/preferences/"

  # New accounts start with Ambrosia's GTK colors; the CSS follows the package.
  install -d "$pkgdir/etc/skel/.config/gtk-4.0" "$pkgdir/etc/skel/.config/gtk-3.0"
  printf '@import url("file:///usr/share/ambrosia/gtk-4.0/gtk.css");\n' > "$pkgdir/etc/skel/.config/gtk-4.0/gtk.css"
  printf '@import url("file:///usr/share/ambrosia/gtk-3.0/gtk-light.css");\n' > "$pkgdir/etc/skel/.config/gtk-3.0/gtk.css"
}
