# The system's name is Ambrosia: our os-release goes in /etc, where it takes
# precedence over Arch's in /usr/lib. filesystem puts its symlink back there
# when it updates, so this runs again then.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = etc/os-release
Target = usr/lib/os-release
Target = usr/share/ambrosia/os-release

[Action]
Description = Naming the system Ambrosia in /etc/os-release...
When = PostTransaction
Exec = /usr/bin/cp --remove-destination /usr/share/ambrosia/os-release /etc/os-release
