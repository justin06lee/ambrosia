# Ambrosia's Clear Light for Konsole: the colors of macOS 27 Terminal's profile of that
# name (its stored values, read with `defaults export com.apple.Terminal`), the
# faint ones halfway to the background. The window lets a little of what is
# behind it through, blurred, as that profile does.

[Background]
Color=255,255,255

[BackgroundFaint]
Color=255,255,255

[BackgroundIntense]
Color=255,255,255

[Color0]
Color=45,56,64

[Color0Faint]
Color=150,155,160

[Color0Intense]
Color=80,101,115

[Color1]
Color=180,86,72

[Color1Faint]
Color=217,170,163

[Color1Intense]
Color=223,108,90

[Color2]
Color=108,170,113

[Color2Faint]
Color=182,213,184

[Color2Intense]
Color=121,190,126

[Color3]
Color=196,172,98

[Color3Faint]
Color=226,213,177

[Color3Intense]
Color=229,200,114

[Color4]
Color=86,133,168

[Color4Faint]
Color=171,194,211

[Color4Intense]
Color=73,162,225

[Color5]
Color=173,100,190

[Color5Faint]
Color=214,177,222

[Color5Intense]
Color=211,137,229

[Color6]
Color=105,198,201

[Color6Faint]
Color=180,226,228

[Color6Intense]
Color=119,225,229

[Color7]
Color=193,200,204

[Color7Faint]
Color=224,228,230

[Color7Intense]
Color=216,225,231

[Foreground]
Color=45,56,64

[ForegroundFaint]
Color=150,155,159

[ForegroundIntense]
Color=37,46,52

[General]
Anchor=0.5,0.5
Blur=true
ColorRandomization=false
Description=Clear Light
FillStyle=Tile
Opacity=0.93
Wallpaper=
