# Super+Ctrl+Alt+3 takes a picture of the screen: ⇧⌘3 on the Mac-first
# keyboard, which keyd hands on as exactly this. The picture goes to the
# Desktop and floats in the screen's corner for a moment (shell/Screenshot.qml).
# It can be changed in System Settings, Shortcuts, like Search's.
[Desktop Entry]
Type=Application
Name=Screenshot of the Screen
Comment=Save a picture of the screen to the Desktop
Icon=applets-screenshooter
Exec=/usr/bin/ambrosia screenshot screen
NoDisplay=true
StartupNotify=false
X-KDE-Shortcuts=Meta+Ctrl+Alt+3
