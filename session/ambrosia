#!/bin/sh
# Talks to the running Ambrosia shell. Keyboard shortcuts run these.
#   ambrosia search           open or close Search
#   ambrosia control-center   open or close the control center
#   ambrosia notification-center   open or close Notification Center
#   ambrosia force-quit       open or close Force Quit Applications
#   ambrosia quit             ask every window of the app in front to close
#   ambrosia screenshot [screen|region]   a picture of the screen, or of a
#                             part dragged out, to the Desktop
#   ambrosia window-menu X Y  where the window in front can go, as a menu at
#                             that place on the screen (the window frame's
#                             green light runs this)
shell=${AMBROSIA_SHELL:-/usr/share/ambrosia/shell}
case $1 in
  search) function=search ;;
  control-center) function=controlCenter ;;
  notification-center) function=notificationCenter ;;
  force-quit) function=forceQuit ;;
  quit) function=quit ;;
  window-menu) function=windowMenu ;;
  screenshot) function=screenshot; [ $# -gt 1 ] || set -- screenshot screen ;;
  *) echo "usage: ambrosia search | control-center | notification-center | force-quit | quit | screenshot [screen|region] | window-menu X Y" >&2; exit 2 ;;
esac
shift
exec quickshell ipc --path "$shell" call shell "$function" "$@"
