# Super+Ctrl+Alt+Esc opens Force Quit Applications: ⌥⌘Esc on the Mac-first
# keyboard, which keyd hands on as exactly this (shell/ForceQuit.qml).
# It can be changed in System Settings, Shortcuts, like Search's.
[Desktop Entry]
Type=Application
Name=Force Quit Applications
Comment=Choose an app to end without asking it
Icon=process-stop
Exec=/usr/bin/ambrosia force-quit
NoDisplay=true
StartupNotify=false
X-KDE-Shortcuts=Meta+Ctrl+Alt+Esc
