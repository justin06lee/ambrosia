#!/bin/sh
# Restarts each logged-in user's Ambrosia shell after pacman upgrades the
# shell, its Theme module or Quickshell, so the new version takes over. The
# installed shell doesn't reload itself when its files change (see shell.qml).
# Users not running it, and systems with no one logged in, are left alone.
for user in $(loginctl list-users --no-legend 2>/dev/null | awk '{ print $2 }'); do
    systemctl --user -M "$user@" --no-block try-restart ambrosia-shell.service 2>/dev/null
done
exit 0
