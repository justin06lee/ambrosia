# Ambrosia session defaults for KWin. A user's own kwinrc wins.

# Window buttons on the left, in Mac order: close, minimize, zoom.
[org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=
# No borders on the sides or bottom, as on a Mac; KWin keeps an invisible
# edge to resize by. (The frame itself, Ambrosia's decoration plugin, comes
# from the look-and-feel package; see startambrosia.)
BorderSize=None
BorderSizeAuto=false
# No tooltips naming the lights: a Mac's have none, and the green one's
# menu opens where the tooltip would.
ShowToolTips=false

# No hot corner by default. (KWin's Overview is off below, Mission Control
# being ours; this holds if someone switches it back on.)
[Effect-overview]
BorderActivate=9

[ElectricBorders]
TopLeft=None

[Plugins]
# Glass is an effect of ours (glass/effect, in ambrosia-glass): each pane
# blurs and saturates what is behind it as its material asks. Once it is up
# it unloads KWin's blur, which stays switched on here for the day ours
# can't load (it is built for one KWin version, and a newer KWin refuses it
# until it is rebuilt): every glass then gets [Effect-blur] below.
ambrosia_glassEnabled=true
blurEnabled=true
# Menus snap open, as the preview's do.
fadingpopupsEnabled=false
# A window minimizes into its Dock tile with the Genie effect, a Mac's
# default (KWin's Magic Lamp; the Dock tells KWin where each app's tile
# is). Settings' Desktop & Dock switches to Scale (KWin's Squash).
magiclampEnabled=true
squashEnabled=false
# A window swells open and closes at once, as a Mac's does: an effect of
# ours (session/kwin-effects/ambrosia_windows) in place of KWin's Scale,
# which shrinks a closing window away.
scaleEnabled=false
ambrosia_windowsEnabled=true
# A window tiled to an edge keeps a margin round it, as a Mac's does: a
# script of ours (session/kwin-scripts/ambrosia_tiles).
ambrosia_tilesEnabled=true
# Mission Control and one app's windows spread out (a Mac's ⌃↑ and ⌃↓, four
# fingers up and down) are an effect of ours
# (session/kwin-effects/ambrosia_mission) in place of KWin's Overview, which
# would answer the same gesture.
overviewEnabled=false
ambrosia_missionEnabled=true
# Show Desktop is ours too (the windows effect: they slide off, the shell
# stays). KWin's own would hide the shell's wallpaper and menu bar, so a
# script of ours (session/kwin-scripts/ambrosia_desktop) turns every request
# for it into ours, and KWin's animation for it is off.
ambrosia_desktopEnabled=true
# A window that resizes itself keeps its top left corner (KWin grows it
# around its middle): session/kwin-scripts/ambrosia_anchor.
ambrosia_anchorEnabled=true
# An app in front may bring another window of its forward even when asked
# from our menu bar (KWin refuses without a key press in the app):
# session/kwin-scripts/ambrosia_forward.
ambrosia_forwardEnabled=true
# A window made full screen gets a Space of its own, as on a Mac, and
# gives it up when it leaves full screen or closes:
# session/kwin-scripts/ambrosia_spaces.
ambrosia_spacesEnabled=true
windowapertureEnabled=false
eyeonscreenEnabled=false

# The Genie at a Mac's unhurried pace (KWin's own is 250 ms). By eye:
# there is no recording to measure yet.
[Effect-magiclamp]
AnimationDuration=400

# Where a window dragged to an edge will land is shown as a pane of glass
# of ours (session/kwin-outline), not KWin's outline. Under /usr/share.
[Outline]
QmlPath=kwin/outline/ambrosia/outline.qml

# KWin's own blur, which only draws where our glass effect could not load.
# It has one setting for every surface, where the design asks for a light,
# untinted blur behind the control center and a heavy, saturated one
# (160-180%) behind menus, the Dock and the menu bar. KWin's defaults, a blur
# stronger than 9 and a saturation boost, turn the control center's backdrop
# into a solid blue panel; the control center's look wins: a middle
# strength, and saturation left as is (100 = 100%).
[Effect-blur]
BlurStrength=6
Saturation=100

# ⌘Tab walks apps, not windows: one icon an app, on a strip of our own (the
# look-and-feel package's windowswitcher), and the windows behind stay as
# they are while it is up.
[TabBox]
ApplicationsMode=1
LayoutName=org.ambrosia.desktop
HighlightWindows=false

# The session's input method is ours (input/, ambrosia-input): it draws
# nothing and takes no keys, and is how the emoji picker's choice is typed
# into the app in front. Choosing another in KDE's Virtual Keyboard settings
# (fcitx5, say) takes its place; the picker then copies its choice instead.
[Wayland]
InputMethod=/usr/share/applications/org.ambrosia.input.desktop
VirtualKeyboardEnabled=true

# Super alone does nothing: it's Command, held for shortcuts. (Plasma's
# default opens plasmashell's launcher, which isn't running here.)
[ModifierOnlyShortcuts]
Meta=
