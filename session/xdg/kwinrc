# Ambrosia session defaults for KWin. A user's own kwinrc wins.

# Window buttons on the left, in Mac order: close, minimize, zoom.
[org.kde.kdecoration2]
ButtonsOnLeft=XIA
ButtonsOnRight=

# No hot corner by default.
[Effect-overview]
BorderActivate=9

[ElectricBorders]
TopLeft=None

[Plugins]
blurEnabled=true
# Menus snap open, as the preview's do.
fadingpopupsEnabled=false

# How glass treats what's behind it. KWin has one setting for every surface,
# where the design asks for a light, untinted blur behind the control center
# and a heavy, saturated one (160-180%) behind menus, the Dock and the menu
# bar. KWin's defaults, a blur stronger than 9 and a saturation boost, turn
# the control center's backdrop into a solid blue panel; the control center's
# look wins: a middle strength, and saturation left as is (100 = 100%).
[Effect-blur]
BlurStrength=6
Saturation=100

# Super alone does nothing: it's Command, held for shortcuts. (Plasma's
# default opens plasmashell's launcher, which isn't running here.)
[ModifierOnlyShortcuts]
Meta=
