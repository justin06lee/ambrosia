#!/bin/sh
# Starts an Ambrosia session: Plasma's session services (KWin, kded, portals,
# polkit, power) with the Ambrosia shell in place of plasmashell. The swap is
# done by systemd units keyed on XDG_SESSION_DESKTOP, which Plasma copies into
# the user manager at every login.
export XDG_SESSION_DESKTOP=ambrosia

# Session defaults (kdeglobals, kwinrc) layered under the user's own config,
# so they apply in this session only. kdeglobals names the session's
# look-and-feel package, org.ambrosia.desktop.
export XDG_CONFIG_DIRS="/etc/xdg/ambrosia:${XDG_CONFIG_DIRS:-/etc/xdg}"
# Apps that stand in for a Mac's go by the Mac's name (Konsole as Terminal;
# /usr/share/ambrosia/mac-names lists them). Each gets a copy of its own
# desktop entry with only the name changed, in a folder that comes before
# the apps' own; made again at every login, so it follows the app's entry as
# the app is updated, and goes when the app does. A copy that hasn't changed
# is left alone, so KDE doesn't rebuild its list of apps for nothing.
data_dirs=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
names=${XDG_CACHE_HOME:-$HOME/.cache}/ambrosia/xdg
rm -rf "$names/next"
mkdir -p "$names/applications" "$names/next"
while read -r id name; do
  case $id in '' | '#'*) continue ;; esac
  for dir in $(printf '%s' "$data_dirs" | tr ':' ' '); do
    [ -r "$dir/applications/$id.desktop" ] || continue
    # The name in the entry's own group; an action's name is its own.
    awk -v name="$name" '
      /^\[/ { main = ($0 == "[Desktop Entry]") }
      main && /^Name\[/ { next }
      main && /^Name=/ { print "Name=" name; next }
      { print }' "$dir/applications/$id.desktop" > "$names/next/$id.desktop"
    break
  done
done < /usr/share/ambrosia/mac-names
for old in "$names"/applications/*.desktop; do
  [ -e "$old" ] && [ ! -e "$names/next/${old##*/}" ] && rm -f "$old"
done
for new in "$names"/next/*.desktop; do
  [ -e "$new" ] || continue
  cmp -s "$new" "$names/applications/${new##*/}" || mv -f "$new" "$names/applications/${new##*/}"
done
rm -rf "$names/next"
export XDG_DATA_DIRS="$names:$data_dirs"
# GSettings defaults for this session only, over the user's own: GTK apps'
# window controls on the left (/etc/dconf/db/ambrosia.d).
export DCONF_PROFILE=ambrosia

# The look-and-feel's window decoration, icons, pointer and widget style, kept
# current in Plasma's copy of its defaults: Plasma rewrites
# ~/.config/kdedefaults only when the look-and-feel package's name changes, so
# users from before a new decoration, icon theme, pointer or style keep the
# old. One the user picked (their own kwinrc, kdeglobals, kcminputrc) still
# wins.
lnf=/usr/share/plasma/look-and-feel/org.ambrosia.desktop/contents/defaults
config=${XDG_CONFIG_HOME:-$HOME/.config}
keep_current() { # file group key
  value=$(kreadconfig6 --file "$lnf" --group "$1" --group "$2" --key "$3")
  if [ -n "$value" ]; then
    kwriteconfig6 --file "$config/kdedefaults/$1" --group "$2" --key "$3" "$value"
  else
    kwriteconfig6 --file "$config/kdedefaults/$1" --group "$2" --key "$3" --delete
  fi
}
keep_current kwinrc org.kde.kdecoration2 library
keep_current kwinrc org.kde.kdecoration2 theme
keep_current kdeglobals Icons Theme
keep_current kdeglobals KDE widgetStyle
keep_current kcminputrc Mouse cursorTheme
# Ambrosia's frame used to be an Aurorae theme the shell wrote into the user's
# own kwinrc; that copy would outrank the plugin, so it goes. A decoration the
# user picked stays.
case "$(kreadconfig6 --file "$config/kwinrc" --group org.kde.kdecoration2 --key theme)" in
__aurorae__svg__Ambrosia*)
  for key in library theme; do
    kwriteconfig6 --file "$config/kwinrc" --group org.kde.kdecoration2 --key "$key" --delete
  done ;;
esac

# Konsole remembers which of its toolbars show. As the session's Terminal it
# has none until asked (session/konsole/konsoleui.rc): what it remembered
# from before that is dropped, once, so the new default holds.
konsole_state="${XDG_STATE_HOME:-$HOME/.local/state}/konsolestaterc"
if [ -f "$konsole_state" ] && [ "$(kreadconfig6 --file "$konsole_state" --group Ambrosia --key toolbars)" != 1 ]; then
  kwriteconfig6 --file "$konsole_state" --group MainWindow --key State --delete
  kwriteconfig6 --file "$konsole_state" --group Ambrosia --key toolbars 1
fi

# Open and Save are Files' own panels in every app that asks the desktop
# portal for one (session/xdg/xdg-desktop-portal/portals.conf). Qt and KDE
# apps ask it when Plasma's platform theme is told to, GTK apps when GTK is.
export PLASMA_INTEGRATION_USE_PORTAL=1
export GTK_USE_PORTAL=1
export GDK_DEBUG=portals

set -a
. /usr/share/ambrosia/environment.d/50-ambrosia-fonts.conf
set +a

exec /usr/bin/startplasma-wayland "$@"
