[Desktop Entry]
Type=Application
Name=Font Book
GenericName=Font Viewer
Comment=Look through the computer's fonts and add your own
Icon=org.ambrosia.fontbook
Exec=ambrosia-fontbook %F
Categories=Qt;Utility;Graphics;
MimeType=font/ttf;font/otf;font/collection;font/sfnt;application/x-font-ttf;application/x-font-otf;application/x-font-truetype;application/x-font-opentype;application/vnd.ms-opentype;application/x-font-type1;
Keywords=font;fonts;typeface;type;ttf;otf;install;glyph;character;
StartupNotify=true
StartupWMClass=org.ambrosia.fontbook
